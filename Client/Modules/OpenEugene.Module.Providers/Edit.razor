@using OpenEugene.Module.Providers.Services
@using OpenEugene.LittleHelpBook.Models

@namespace OpenEugene.Module.Providers
@inherits ModuleBase
@inject IProviderService ProviderService
@inject NavigationManager NavigationManager

@if (!_isLoaded)
{
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudProgressCircular Indeterminate="true" Size="Size.Small" aria-hidden="true" />
        <MudText role="status">Loading...</MudText>
    </MudStack>
}
else
{
    <MudStack Spacing="4">
        <MudPaper Class="pa-4" Outlined="true">
            <MudStack Spacing="2">
                <MudTextField T="string" @bind-Value="_detail.Provider.Name" Label="Name" Variant="Variant.Outlined" MaxLength="200"
                              Required="true" Error="@_invalidFields.Contains("Name")" ErrorText="Name is required" />
                <MudTextField T="string" @bind-Value="_detail.Provider.Description" Label="Description" Variant="Variant.Outlined" Lines="4" MaxLength="2000" />
                <MudTextField T="string" @bind-Value="_detail.Provider.WebAddress" Label="Website" Variant="Variant.Outlined" MaxLength="500" />
                <MudTextField T="string" @bind-Value="_detail.Provider.EmailAddress" Label="Email" Variant="Variant.Outlined" InputType="InputType.Email" MaxLength="100" />
                <MudTextField T="string" @bind-Value="_detail.Provider.HoursOfOperation" Label="Hours" Variant="Variant.Outlined" MaxLength="500" />
                <MudCheckBox T="bool" @bind-Value="_detail.Provider.IsActive" Label="Active" />
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-2">Addresses</MudText>
            @for (int i = 0; i < _detail.Addresses.Count; i++)
            {
                var index = i;
                var address = _detail.Addresses[index];
                <MudPaper Class="pa-3 mb-3" Outlined="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.subtitle1">Address @(index + 1)</MudText>
                        <MudIconButton Icon="@MudBlazor.Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       aria-label="@($"Remove address {index + 1}")" OnClick="() => _detail.Addresses.RemoveAt(index)" />
                    </MudStack>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="address.Address1" Label="Street" Variant="Variant.Outlined" MaxLength="120" /></MudItem>
                        <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="address.Address2" Label="Street (line 2)" Variant="Variant.Outlined" MaxLength="120" /></MudItem>
                        <MudItem xs="12" sm="5"><MudTextField T="string" @bind-Value="address.City" Label="City" Variant="Variant.Outlined" MaxLength="100" /></MudItem>
                        <MudItem xs="4" sm="2"><MudTextField T="string" @bind-Value="address.State" Label="State" Variant="Variant.Outlined" MaxLength="2" /></MudItem>
                        <MudItem xs="8" sm="5"><MudTextField T="string" @bind-Value="address.PostalCode" Label="Postal code" Variant="Variant.Outlined" MaxLength="16" /></MudItem>
                        <MudItem xs="12">
                            <MudCheckBox T="bool" @bind-Value="address.HasWheelchairAccess" Label="Wheelchair access" />
                            <MudCheckBox T="bool" @bind-Value="address.HasLanguageSupport" Label="Language support" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@MudBlazor.Icons.Material.Filled.Add"
                       OnClick="() => _detail.Addresses.Add(new Address())">Add address</MudButton>
        </MudPaper>

        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-2">Phone numbers</MudText>
            @for (int i = 0; i < _detail.PhoneNumbers.Count; i++)
            {
                var index = i;
                var phone = _detail.PhoneNumbers[index];
                <MudGrid Spacing="2" Class="mb-2">
                    <MudItem xs="12" sm="4"><MudTextField T="string" @bind-Value="phone.Number" Label="Number" Variant="Variant.Outlined" MaxLength="500" /></MudItem>
                    <MudItem xs="4" sm="2"><MudNumericField T="int?" @bind-Value="phone.Extension" Label="Ext." Variant="Variant.Outlined" HideSpinButtons="true" /></MudItem>
                    <MudItem xs="6" sm="5"><MudTextField T="string" @bind-Value="phone.Description" Label="Description" Variant="Variant.Outlined" MaxLength="500" /></MudItem>
                    <MudItem xs="2" sm="1" Class="d-flex align-center">
                        <MudIconButton Icon="@MudBlazor.Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       aria-label="@($"Remove phone number {index + 1}")" OnClick="() => _detail.PhoneNumbers.RemoveAt(index)" />
                    </MudItem>
                </MudGrid>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@MudBlazor.Icons.Material.Filled.Add"
                       OnClick="() => _detail.PhoneNumbers.Add(new PhoneNumber())">Add phone number</MudButton>
        </MudPaper>

        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.h6">Categories</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">Choosing a subcategory also puts the provider in its category.</MudText>
            @foreach (var tree in _categories)
            {
                var category = tree.Category;
                <fieldset class="mb-2">
                    <legend class="visually-hidden">@category.Name</legend>
                    <MudCheckBox T="bool" Value="@_detail.CategoryIds.Contains(category.CategoryId)"
                                 ValueChanged="@((bool value) => ToggleCategory(category.CategoryId, value))"
                                 Label="@category.Name" />
                    @foreach (var sub in tree.SubCategories)
                    {
                        <div class="ms-8">
                            <MudCheckBox T="bool" Value="@_detail.SubCategoryIds.Contains(sub.SubCategoryId)"
                                         ValueChanged="@((bool value) => ToggleSubCategory(sub, value))"
                                         Label="@sub.Name" Size="Size.Small" />
                        </div>
                    }
                </fieldset>
            }
        </MudPaper>

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="Save" Disabled="@_isSaving"
                       StartIcon="@(_isSaving ? null : MudBlazor.Icons.Material.Filled.Check)">
                @if (_isSaving)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" aria-hidden="true" />
                    <span>Saving...</span>
                }
                else
                {
                    <span>Save</span>
                }
            </MudButton>
            <MudButton Variant="Variant.Outlined" Href="@NavigateUrl()">Cancel</MudButton>
        </MudStack>
        <span class="visually-hidden" role="status">@(_isSaving ? "Saving..." : "")</span>

        @if (PageState.Action == "Edit")
        {
            <AuditInfo CreatedBy="@_detail.Provider.CreatedBy" CreatedOn="@_detail.Provider.CreatedOn" ModifiedBy="@_detail.Provider.ModifiedBy" ModifiedOn="@_detail.Provider.ModifiedOn"></AuditInfo>
        }
    </MudStack>
}

@code {
    public override SecurityAccessLevel SecurityAccessLevel => SecurityAccessLevel.Edit;

    public override string Actions => "Add,Edit";

    // Edit pages render in the page's normal container, never the admin popup.
    public override bool UseAdminContainer => false;

    public override string Title => "Manage Provider";

    private ProviderDetail _detail = new ProviderDetail();
    private List<CategoryTree> _categories = new List<CategoryTree>();
    private HashSet<string> _invalidFields = new();
    private bool _isLoaded;
    private bool _isSaving;
    private int _id;

    protected override async Task OnParametersSetAsync()
    {
        if (_isLoaded)
        {
            return;
        }
        try
        {
            _categories = await ProviderService.GetCategoriesAsync(ModuleState.ModuleId) ?? new List<CategoryTree>();
            if (PageState.Action == "Edit" && PageState.QueryString.ContainsKey("id"))
            {
                _id = int.Parse(PageState.QueryString["id"]);
                _detail = await ProviderService.GetProviderAsync(_id, ModuleState.ModuleId) ?? new ProviderDetail();
            }
            _isLoaded = true;
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Provider {ProviderId} {Error}", PageState.QueryString.GetValueOrDefault("id"), ex.Message);
            AddModuleMessage("The provider could not be loaded.", MessageType.Error);
        }
    }

    private void ToggleCategory(int categoryId, bool isChecked)
    {
        if (isChecked)
        {
            if (!_detail.CategoryIds.Contains(categoryId)) _detail.CategoryIds.Add(categoryId);
        }
        else
        {
            _detail.CategoryIds.Remove(categoryId);
            // A provider can't stay in a subcategory without its category.
            var subIds = _categories.Where(item => item.Category.CategoryId == categoryId)
                .SelectMany(item => item.SubCategories).Select(item => item.SubCategoryId);
            _detail.SubCategoryIds.RemoveAll(id => subIds.Contains(id));
        }
    }

    private void ToggleSubCategory(SubCategory sub, bool isChecked)
    {
        if (isChecked)
        {
            if (!_detail.SubCategoryIds.Contains(sub.SubCategoryId)) _detail.SubCategoryIds.Add(sub.SubCategoryId);
            if (!_detail.CategoryIds.Contains(sub.CategoryId)) _detail.CategoryIds.Add(sub.CategoryId);
        }
        else
        {
            _detail.SubCategoryIds.Remove(sub.SubCategoryId);
        }
    }

    private async Task Save()
    {
        ClearModuleMessage();
        _invalidFields.Clear();

        var missing = new List<string>();
        if (string.IsNullOrWhiteSpace(_detail.Provider.Name)) { _invalidFields.Add("Name"); missing.Add("Name"); }

        if (missing.Count > 0)
        {
            AddModuleMessage($"Required: {string.Join(", ", missing)}", MessageType.Warning);
            await ScrollToPageTop();
            return;
        }

        _isSaving = true;
        try
        {
            if (PageState.Action == "Add")
            {
                _detail = await ProviderService.AddProviderAsync(_detail, ModuleState.ModuleId);
                await logger.LogInformation("Provider Added {ProviderId}", _detail.Provider.ProviderId);
            }
            else
            {
                await ProviderService.UpdateProviderAsync(_detail, ModuleState.ModuleId);
                await logger.LogInformation("Provider Updated {ProviderId}", _id);
            }
            NavigationManager.NavigateTo(NavigateUrl());
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Saving Provider {Error}", ex.Message);
            AddModuleMessage("The provider could not be saved.", MessageType.Error);
            await ScrollToPageTop();
        }
        finally
        {
            _isSaving = false;
        }
    }
}
