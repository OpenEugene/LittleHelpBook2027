@page "/providers"
@using OpenEugene.Module.Providers.Services
@using OpenEugene.LittleHelpBook.Models

@namespace OpenEugene.Module.Providers
@inherits ModuleBase
@inject IProviderService ProviderService
@inject NavigationManager NavigationManager

@if (_providers == null)
{
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudProgressCircular Indeterminate="true" Size="Size.Small" aria-hidden="true" />
        <MudText role="status">Loading...</MudText>
    </MudStack>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.End" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mb-3">
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
            <MudSelect T="int" Value="_categoryId" ValueChanged="OnCategoryChanged" Label="Category" Variant="Variant.Outlined" Style="min-width: 16rem;">
                <MudSelectItem T="int" Value="0">All categories</MudSelectItem>
                @foreach (var tree in _categories)
                {
                    <MudSelectItem T="int" Value="@tree.Category.CategoryId">@tree.Category.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="int" @bind-Value="_subCategoryId" Label="Subcategory" Variant="Variant.Outlined" Style="min-width: 16rem;"
                       Disabled="@(_categoryId == 0)">
                <MudSelectItem T="int" Value="0">All subcategories</MudSelectItem>
                @foreach (var sub in SubCategories)
                {
                    <MudSelectItem T="int" Value="@sub.SubCategoryId">@sub.Name</MudSelectItem>
                }
            </MudSelect>
        </MudStack>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
            <MudButton Href="@EditUrl("Map")"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@MudBlazor.Icons.Material.Filled.Map">
                Map view
            </MudButton>
            <ActionLink Action="Add" Security="SecurityAccessLevel.Edit" Text="Add Provider" />
        </MudStack>
    </MudStack>

    <MudTable Items="@FilteredProviders" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" RowsPerPage="25"
              OnRowClick="@((TableRowClickEventArgs<ProviderListItem> e) => ShowDetails(e.Item))" RowStyle="cursor: pointer;">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Categories</MudTh>
            <MudTh>Subcategories</MudTh>
        </HeaderContent>
        <RowTemplate>
            @* The name is a real link so keyboard users can open the details too. *@
            <MudTd DataLabel="Name"><a href="@DetailsUrl(context)">@context.Name</a></MudTd>
            <MudTd DataLabel="Categories">@CategoryNames(context)</MudTd>
            <MudTd DataLabel="Subcategories">@SubCategoryNames(context)</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No providers to show.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
}

@code {
    private List<ProviderListItem> _providers;
    private List<CategoryTree> _categories = new List<CategoryTree>();
    private Dictionary<int, string> _categoryNames = new Dictionary<int, string>();
    private Dictionary<int, string> _subCategoryNames = new Dictionary<int, string>();
    private int _categoryId;
    private int _subCategoryId;

    // Subcategories of the chosen category; empty while "All categories" is chosen.
    private List<SubCategory> SubCategories =>
        _categories.FirstOrDefault(item => item.Category.CategoryId == _categoryId)?.SubCategories ?? new List<SubCategory>();

    // Inactive providers are never listed.
    private List<ProviderListItem> FilteredProviders => _providers
        .Where(item => item.IsActive)
        .Where(item => _categoryId == 0 || item.CategoryIds.Contains(_categoryId))
        .Where(item => _subCategoryId == 0 || item.SubCategoryIds.Contains(_subCategoryId))
        .ToList();

    // A new category resets the subcategory to "All subcategories".
    private void OnCategoryChanged(int categoryId)
    {
        _categoryId = categoryId;
        _subCategoryId = 0;
    }

    protected override async Task OnParametersSetAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        try
        {
            _categories = await ProviderService.GetCategoriesAsync(ModuleState.ModuleId) ?? new List<CategoryTree>();
            _categoryNames = _categories.ToDictionary(item => item.Category.CategoryId, item => item.Category.Name);
            _subCategoryNames = _categories.SelectMany(item => item.SubCategories).ToDictionary(item => item.SubCategoryId, item => item.Name);
            _providers = await ProviderService.GetProvidersAsync(ModuleState.ModuleId) ?? new List<ProviderListItem>();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Providers {Error}", ex.Message);
            AddModuleMessage("Providers could not be loaded.", MessageType.Error);
            _providers ??= new List<ProviderListItem>();
        }
    }

    private string CategoryNames(ProviderListItem provider)
    {
        return string.Join(", ", provider.CategoryIds
            .Where(id => _categoryNames.ContainsKey(id))
            .Select(id => _categoryNames[id])
            .OrderBy(name => name));
    }

    private string SubCategoryNames(ProviderListItem provider)
    {
        return string.Join(", ", provider.SubCategoryIds
            .Where(id => _subCategoryNames.ContainsKey(id))
            .Select(id => _subCategoryNames[id])
            .OrderBy(name => name));
    }

    private string DetailsUrl(ProviderListItem provider) => EditUrl("Details", $"id={provider.ProviderId}");

    private void ShowDetails(ProviderListItem provider)
    {
        NavigationManager.NavigateTo(DetailsUrl(provider));
    }
}
