@page "/providers"
@using OpenEugene.Module.Providers.Services
@using OpenEugene.LittleHelpBook.Models

@namespace OpenEugene.Module.Providers
@inherits ModuleBase
@inject IProviderService ProviderService

@if (_providers == null)
{
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudProgressCircular Indeterminate="true" Size="Size.Small" aria-hidden="true" />
        <MudText role="status">Loading...</MudText>
    </MudStack>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.End" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mb-3">
        <MudSelect T="int" @bind-Value="_categoryId" Label="Category" Variant="Variant.Outlined" Style="min-width: 16rem;">
            <MudSelectItem T="int" Value="0">All categories</MudSelectItem>
            @foreach (var tree in _categories)
            {
                <MudSelectItem T="int" Value="@tree.Category.CategoryId">@tree.Category.Name</MudSelectItem>
            }
        </MudSelect>
        <ActionLink Action="Add" Security="SecurityAccessLevel.Edit" Text="Add Provider" />
    </MudStack>

    <MudTable Items="@FilteredProviders" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" RowsPerPage="25">
        <HeaderContent>
            <MudTh Style="width: 1px;"><span class="visually-hidden">Edit</span></MudTh>
            <MudTh Style="width: 1px;"><span class="visually-hidden">Delete</span></MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Categories</MudTh>
            <MudTh>Active</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><ActionLink Action="Edit" Parameters="@($"id={context.ProviderId}")" /></MudTd>
            <MudTd><ActionDialog Header="Delete Provider" Message="@($"Delete {context.Name}? This also removes its addresses, phone numbers and category links.")" Action="Delete" Security="SecurityAccessLevel.Edit" Class="btn btn-danger" OnClick="@(async () => await Delete(context))" Id="@context.ProviderId.ToString()" /></MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Categories">@CategoryNames(context)</MudTd>
            <MudTd DataLabel="Active">@(context.IsActive ? "Yes" : "No")</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No providers to show.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
}

@code {
    private List<ProviderListItem> _providers;
    private List<CategoryTree> _categories = new List<CategoryTree>();
    private Dictionary<int, string> _categoryNames = new Dictionary<int, string>();
    private int _categoryId;

    private List<ProviderListItem> FilteredProviders =>
        _categoryId == 0 ? _providers : _providers.Where(item => item.CategoryIds.Contains(_categoryId)).ToList();

    protected override async Task OnParametersSetAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        try
        {
            _categories = await ProviderService.GetCategoriesAsync(ModuleState.ModuleId) ?? new List<CategoryTree>();
            _categoryNames = _categories.ToDictionary(item => item.Category.CategoryId, item => item.Category.Name);
            _providers = await ProviderService.GetProvidersAsync(ModuleState.ModuleId) ?? new List<ProviderListItem>();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Providers {Error}", ex.Message);
            AddModuleMessage("Providers could not be loaded.", MessageType.Error);
            _providers ??= new List<ProviderListItem>();
        }
    }

    private string CategoryNames(ProviderListItem provider)
    {
        return string.Join(", ", provider.CategoryIds
            .Where(id => _categoryNames.ContainsKey(id))
            .Select(id => _categoryNames[id])
            .OrderBy(name => name));
    }

    private async Task Delete(ProviderListItem provider)
    {
        try
        {
            await ProviderService.DeleteProviderAsync(provider.ProviderId, ModuleState.ModuleId);
            await logger.LogInformation("Provider Deleted {ProviderId}", provider.ProviderId);
            await Load();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Deleting Provider {ProviderId} {Error}", provider.ProviderId, ex.Message);
            AddModuleMessage($"{provider.Name} could not be deleted.", MessageType.Error);
        }
    }
}
