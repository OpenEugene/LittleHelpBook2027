@page "/categories"
@attribute [Authorize(Roles = RoleNames.Admin)]
@using OpenEugene.Module.Categories.Services
@using OpenEugene.LittleHelpBook.Models

@namespace OpenEugene.Module.Categories
@inherits ModuleBase
@inject ICategoryService CategoryService

@if (_categories == null)
{
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudProgressCircular Indeterminate="true" Size="Size.Small" aria-hidden="true" />
        <MudText role="status">Loading...</MudText>
    </MudStack>
}
else
{
    <MudStack Spacing="3">
        <div>
            <ActionLink Action="Add" Security="SecurityAccessLevel.Edit" Text="Add Category" />
        </div>
        @if (_categories.Count != 0)
        {
            @foreach (var tree in _categories)
            {
                var category = tree.Category;
                <MudPaper Class="pa-3" Outlined="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.h6" Class="flex-grow-1">@category.Name</MudText>
                        <ActionLink Action="Edit" Parameters="@($"id={category.CategoryId}")" />
                        <ActionDialog Header="Delete Category" Message="@($"Delete {category.Name}? This also deletes its subcategories and removes every provider from them.")" Action="Delete" Security="SecurityAccessLevel.Edit" Class="btn btn-danger" OnClick="@(async () => await DeleteCategory(category))" Id="@($"category-{category.CategoryId}")" />
                    </MudStack>
                    <MudDivider Class="my-2" />
                    @foreach (var sub in tree.SubCategories)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="ms-4 mb-1">
                            <MudText Class="flex-grow-1">@sub.Name</MudText>
                            <ActionLink Action="Edit" Parameters="@($"id={sub.SubCategoryId}&type=sub")" />
                            <ActionDialog Header="Delete Subcategory" Message="@($"Delete {sub.Name}? Providers in it stay in {category.Name}.")" Action="Delete" Security="SecurityAccessLevel.Edit" Class="btn btn-danger" OnClick="@(async () => await DeleteSubCategory(sub))" Id="@($"subcategory-{sub.SubCategoryId}")" />
                        </MudStack>
                    }
                    <div class="ms-4 mt-2">
                        <ActionLink Action="Add" Security="SecurityAccessLevel.Edit" Parameters="@($"type=sub&categoryid={category.CategoryId}")" Text="@($"Add subcategory to {category.Name}")" Class="btn btn-sm btn-outline-primary" />
                    </div>
                </MudPaper>
            }
        }
        else
        {
            <MudText>No categories to show.</MudText>
        }
    </MudStack>
}

@code {
    private List<CategoryTree> _categories;

    protected override async Task OnParametersSetAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        try
        {
            _categories = await CategoryService.GetCategoriesAsync(ModuleState.ModuleId) ?? new List<CategoryTree>();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Categories {Error}", ex.Message);
            AddModuleMessage("Categories could not be loaded.", MessageType.Error);
            _categories ??= new List<CategoryTree>();
        }
    }

    private async Task DeleteCategory(Category category)
    {
        try
        {
            await CategoryService.DeleteCategoryAsync(category.CategoryId, ModuleState.ModuleId);
            await logger.LogInformation("Category Deleted {CategoryId}", category.CategoryId);
            await Load();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Deleting Category {CategoryId} {Error}", category.CategoryId, ex.Message);
            AddModuleMessage($"{category.Name} could not be deleted.", MessageType.Error);
        }
    }

    private async Task DeleteSubCategory(SubCategory sub)
    {
        try
        {
            await CategoryService.DeleteSubCategoryAsync(sub.SubCategoryId, ModuleState.ModuleId);
            await logger.LogInformation("SubCategory Deleted {SubCategoryId}", sub.SubCategoryId);
            await Load();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Deleting SubCategory {SubCategoryId} {Error}", sub.SubCategoryId, ex.Message);
            AddModuleMessage($"{sub.Name} could not be deleted.", MessageType.Error);
        }
    }
}
